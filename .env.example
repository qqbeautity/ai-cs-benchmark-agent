# Copy to `.env.local` and fill in. Never commit `.env.local` — it is the
# gitignored one; this file is tracked and must stay key-free.

# Tavily Search — free tier gives 1000 credits/month.
# 5 products x 3 searches = 15 credits per full run  =>  ~66 runs/month free.
# https://app.tavily.com/
TAVILY_API_KEY=

# 大模型。默认接阿里云百炼（通义千问），国内直连。
# 控制台：https://bailian.console.aliyun.com/
LLM_API_KEY=

# OpenAI 兼容端点，**必须和 Key 的来源匹配**：百炼控制台签发的 Key 换到另一个区域
# 或另一个工作空间会直接报 InvalidApiKey，而报错看起来像 Key 本身有问题。常见取值：
#   公开国内站  https://dashscope.aliyuncs.com/compatible-mode/v1
#   公开新加坡  https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   工作空间专属 https://ws-<你的空间 ID>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 第三种是百炼控制台「模型广场 → 调用」里给的地址，上面那两种都没有——照抄控制台，
# 不要照着这里猜。它的 /models 会列出一堆跨厂商模型（glm、deepseek、kimi…）。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名做成可配是刻意的：模型可用性会变，硬编码的名字总有一天会解析不了。
# 见 PLAN.md §3.3。这里填的是**实测过的**那个（严格模式 + 关思考都验过），
# 换成没验过的模型前先跑一次单产品调研。
#
# 不确定你的端点上有哪些模型就直接问它，别猜：
#   curl -s "$LLM_BASE_URL/models" -H "Authorization: Bearer $LLM_API_KEY"
LLM_MODEL=qwen3.8-max

# 结构化输出的约束方式：
#   json_schema  让 provider 在解码层强约束输出结构（默认，最可靠）
#   json_object  只保证是合法 JSON，schema 退化成提示词里的描述
# 严格模式只覆盖 Qwen3.7-Plus / Qwen3.8-Flash / Qwen3.8-Max 等少数系列，换到不支持
# 的模型会直接 400，此时降到 json_object。
#
# `qwen3.8-max` 上 `json_schema` + `strict: true` **已实测有效**，不是被静默降级：
# 返回 200、finish_reason=stop、content 严格符合 schema。不用再探了。
# （不过 schema 描述在两种模式下都同时进提示词，所以就算某个模型把它降级了，
#   输出形状也不会变——只损失可靠性。见 completion.ts。）
LLM_JSON_MODE=json_schema

# 关掉模型自带的思考模式。**Qwen3.8 系列默认是开着的**，而思考 token 和正文共享
# LLM_MAX_TOKENS，也一起计费、一起拖慢响应。实测 `qwen3.8-max` 回答一个
# 「返回 {"ok": true}」：
#     不关  50 completion tokens（其中 38 是推理）
#     关掉   5 completion tokens
# 十倍。十维抽取的输出有几千 token，不关会明显抬高截断风险。
#
# 取值 1 / true / yes 都认；**留空表示完全不发这个字段**，而不是发 false——
# `enable_thinking` 是 Qwen/DashScope 的私有扩展，标准 OpenAI 端点可能拒绝未知
# 字段。换到非 Qwen 的模型时请留空。
LLM_DISABLE_THINKING=1

# 单次模型输出的上限。结构化输出被截断会产生非法 JSON，所以这个值只该调大不该调小。
# 触发截断时错误信息里会同时点名它和 LLM_DISABLE_THINKING。
LLM_MAX_TOKENS=8192

# Max searches per product. 3 keeps a full 5-product run at 15 Tavily credits.
TAVILY_MAX_SEARCHES_PER_PRODUCT=3
