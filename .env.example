# Copy to `.env.local` and fill in. Never commit `.env.local`.

# Tavily Search — free tier gives 1000 credits/month.
# 5 products x 3 searches = 15 credits per full run  =>  ~66 runs/month free.
# https://app.tavily.com/
TAVILY_API_KEY=

# Gemini — free tier is rate limited (roughly 10-30 RPM, 500-1500 RPD).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model name is configurable on purpose: free-tier model availability changes,
# and a hardcoded name will one day stop resolving. See PLAN.md §3.3.
GEMINI_MODEL=gemini-2.5-flash

# Max searches per product. 3 keeps a full 5-product run at 15 Tavily credits.
TAVILY_MAX_SEARCHES_PER_PRODUCT=3
